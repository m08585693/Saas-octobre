# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Les clés Supabase se trouvent dans votre projet Supabase :
# Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE-CLE-ANON

# Une fois déployé sur Vercel : votre URL de production
# (ex: https://arc.vercel.app) — sans slash final
NEXT_PUBLIC_SITE_URL=http://localhost:3000